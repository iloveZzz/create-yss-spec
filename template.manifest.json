{
  "allowRootEntries": [
    ".agents",
    ".codex",
    ".cursor",
    ".pi",
    ".vscode",
    ".template-spec",
    "scripts"
  ],
  "allowRootFiles": [
    ".cursorrules",
    ".gitignore",
    ".nvmrc",
    "AGENTS.md",
    "CONTEXT.md",
    "DESIGN.md",
    "README.md",
    "skills-lock.json",
    "yss-project.yaml",
    "yss-public-skills.json"
  ],
  "allowFiles": [],
  "excludeRootEntries": [
    ".git",
    ".codegraph",
    ".codebuddy",
    ".idea",
    ".uploads",
    "node_modules",
    ".ua",
    ".qwen",
    ".template-source",
    "packages",
    ".github"
  ],
  "excludeRootFiles": [
    "package-lock.json",
    "package.json",
    "template.manifest.json",
    "template.snapshot.json",
    ".gitmodules"
  ],
  "excludePaths": [
    ".codex/hooks.json",
    ".codex/settings.local.json",
    ".codex/skills/.DS_Store",
    ".pi/settings.json",
    ".cursor/environment.json",
    "docs/.scratch",
    "docs/discovery",
    "docs/reviews",
    "docs/adr",
    ".template-source/process/maintenance-intensity.yaml",
    ".template-source/process/schemas/maintenance-review-record.schema.json",
    ".template-source/process/templates/maintenance-checkpoint-template.yaml",
    ".template-source/process/template-verification-profiles.yaml",
    ".template-source/process/template-engineering-overview.md",
    ".template-source/agents/skills-maintenance.md",
    ".template-source/agents/strategic-design-skills-integration.md",
    ".template-source/agents/yss-ui-skills-integration.md",
    "scripts/fixtures",
    "scripts/audit-yss-backend-skills",
    "scripts/cache-template-commit",
    "scripts/capture-maintenance-candidate",
    "scripts/evaluate-maintenance-review-round",
    "scripts/export-yss-skills",
    "scripts/generate-lifecycle-artifacts",
    "scripts/generate-yss-skill-boundaries",
    "scripts/inspect-maintenance-candidate",
    "scripts/instantiate-harness",
    "scripts/node-generate-lifecycle-artifacts.mjs",
    "scripts/node-verify-lifecycle-registry.mjs",
    "scripts/prepare-maintenance-review",
    "scripts/run-template-verification",
    "scripts/sync-strategic-handoff-tools",
    "scripts/verify-maintenance-checkpoint",
    "scripts/verify-maintenance-review-record",
    "scripts/verify-governance-release",
    "scripts/verify-retired-skill-ids",
    "scripts/verify-skill-governance",
    "scripts/verify-skill-registry",
    "scripts/verify-strategic-handoff-tools-lock",
    "scripts/verify-template",
    "scripts/verify-template-candidate",
    "scripts/verify-template-fast",
    "scripts/verify-upstream-skill-source",
    "scripts/lib/maintenance-intensity.mjs",
    "scripts/lib/maintenance-review.mjs",
    "scripts/lib/maintenance-review-workflow.mjs",
    "scripts/lib/scenario-checks.mjs",
    "scripts/lib/skill-governance.mjs",
    "scripts/lib/template-commit-cache.mjs",
    "scripts/lib/template-verification.mjs",
    "scripts/lib/template-verification-runner.mjs"
  ],
  "excludePathSuffixes": ["-scenarios"],
  "renderPaths": [
    ".gitignore",
    "AGENTS.md",
    "README.md",
    "skills-lock.json",
    ".template-spec/user-guide/用户手册.md",
    ".template-spec/user-guide/用户手册索引.md",
    ".template-spec/user-guide/阶段接入与产物复用使用手册.md",
    ".template-spec/user-guide/技术设计用户指南.md",
    ".template-spec/design/README.md",
    ".template-spec/engineering/backend-platforms.json",
    "scripts/lib/skill-supply-chain.mjs",
    ".template-spec/agents/backend-architecture-profiles.md",
    ".agents/skills/yss-design-system/SKILL.md",
    ".agents/skills/yss-design-system/references/data-quality-theme.md",
    ".codex/skills/yss-design-system/SKILL.md",
    ".codex/skills/yss-design-system/references/data-quality-theme.md",
    ".cursor/skills/yss-design-system/SKILL.md",
    ".cursor/skills/yss-design-system/references/data-quality-theme.md",
    ".pi/skills/yss-design-system/SKILL.md",
    ".pi/skills/yss-design-system/references/data-quality-theme.md",
    "yss-project.yaml"
  ],
  "exampleDocPaths": [],
  "initExcludeRootEntries": [],
  "initExcludeRootFiles": [
    "yss-public-skills.json"
  ],
  "initExcludePaths": [],
  "ownershipPolicy": {
    "version": 1,
    "default": "managed",
    "rules": [
      { "pattern": ".git/**", "ownership": "protected" },
      { "pattern": ".template-source/**", "ownership": "protected" },
      { "pattern": ".cursor/environment.json", "ownership": "protected" },
      { "pattern": ".gitmodules", "ownership": "user-owned" },
      { "pattern": ".gitignore", "ownership": "managed-customizable" },
      { "pattern": "apps/**", "ownership": "user-owned" },
      { "pattern": "packages/**", "ownership": "user-owned" },
      { "pattern": "wiki/**", "ownership": "user-owned" },
      { "pattern": "docs/reviews/**", "ownership": "user-owned" },
      { "pattern": "docs/.scratch/**", "ownership": "user-owned" },
      { "pattern": ".template-spec/agents/issue-tracker.md", "ownership": "managed-customizable" },
      { "pattern": "yss-project.yaml", "ownership": "generated" },
      { "pattern": "skills-lock.json", "ownership": "generated" },
      { "pattern": "yss-public-skills.json", "ownership": "generated" },
      { "pattern": ".agents/skills/.yss-skills-manifest.json", "ownership": "generated" },
      { "pattern": "AGENTS.md", "ownership": "managed-customizable" },
      { "pattern": "CONTEXT.md", "ownership": "managed-customizable" },
      { "pattern": "DESIGN.md", "ownership": "managed-customizable" },
      { "pattern": "README.md", "ownership": "user-owned" }
    ]
  },
  "customizationPolicy": {
    "version": 1,
    "defaultStrategy": "replace-with-force",
    "rules": [
      { "pattern": ".gitignore", "strategy": "manual" },
      { "pattern": ".template-spec/agents/issue-tracker.md", "strategy": "manual" },
      { "pattern": "CONTEXT.md", "strategy": "manual" },
      { "pattern": "DESIGN.md", "strategy": "manual" }
    ]
  },
  "generatorPolicy": {
    "version": 1,
    "rules": [
      { "pattern": "yss-project.yaml", "generatorId": "repository-identity", "generatorVersion": 1 },
      { "pattern": "skills-lock.json", "generatorId": "skills-lock", "generatorVersion": 1 },
      { "pattern": "yss-public-skills.json", "generatorId": "public-skills", "generatorVersion": 1 },
      { "pattern": ".agents/skills/.yss-skills-manifest.json", "generatorId": "skills-manifest", "generatorVersion": 1 }
    ]
  }
}
