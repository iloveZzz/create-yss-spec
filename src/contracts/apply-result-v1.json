{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iloveZzz/create-yss-spec/schemas/apply-result-v1.json",
  "title": "create-yss-spec Apply Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "targetDir", "backupPath", "template", "stats", "skipped", "removed"],
  "properties": {
    "operation": { "const": "sync" },
    "targetDir": { "type": "string", "minLength": 1 },
    "backupPath": { "type": ["string", "null"] },
    "template": { "type": ["object", "null"], "additionalProperties": true },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["updated", "added", "skipped", "removed", "forceApplied"],
      "properties": {
        "updated": { "type": "integer", "minimum": 0 },
        "added": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "forceApplied": { "type": "integer", "minimum": 0 }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason", "ownership", "mergeStrategy"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "ownership": { "type": ["string", "null"] },
          "mergeStrategy": { "type": ["string", "null"] }
        }
      }
    },
    "removed": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
