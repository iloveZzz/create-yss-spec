{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iloveZzz/create-yss-spec/schemas/doctor-report-v1.json",
  "title": "create-yss-spec Doctor Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "targetDir", "cliVersion", "ok", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operation": { "const": "doctor" },
    "targetDir": { "type": "string", "minLength": 1 },
    "cliVersion": { "type": "string", "minLength": 1 },
    "ok": { "type": "boolean" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "detail"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["ok", "warning", "error"] },
          "detail": { "type": "string", "minLength": 1 },
          "data": {}
        }
      }
    }
  }
}
