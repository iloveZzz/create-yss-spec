{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iloveZzz/create-yss-spec/schemas/error-envelope-v1.json",
  "title": "create-yss-spec Error Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ok", "error"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ok": { "const": false },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^YSS_[A-Z0-9_]+$"
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
